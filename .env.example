# ── Database ──
MYSQL_ROOT_PASSWORD=REPLACE_WITH_A_STRONG_DATABASE_PASSWORD
ConnectionStrings__DefaultConnection=Server=localhost;Port=3306;Database=quantixdb;User=root;Password=YOUR_PASSWORD;

# ── JWT ──
Jwt__Issuer=QuantixAPI
Jwt__Audience=QuantixClient
Jwt__SecurityKey=YOUR_LONG_SECRET_KEY_HERE_MIN_32_CHARS
Jwt__ExpirationMinutes=60

# ── Email (SMTP) ──
Email__SmtpHost=smtp.gmail.com
Email__SmtpPort=587
Email__SmtpUser=your-email@gmail.com
Email__SmtpPass=your-app-password
Email__FromEmail=noreply@quantix.com
Email__FromName=Quantix

# ── App ──
App__BaseUrl=http://localhost:5000
App__FrontendUrl=http://localhost:3000
Cors__AllowedOrigins__0=http://localhost:3000
Cors__AllowedOrigins__1=http://127.0.0.1:3000

# ── Optional admin account (set both to create one) ──
Seed__AdminEmail=
Seed__AdminPassword=
